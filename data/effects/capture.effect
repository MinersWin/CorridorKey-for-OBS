uniform float4x4 ViewProj;
uniform texture2d image;
uniform texture2d original_image;
uniform texture2d result_image;
uniform float4 crop_bounds;
sampler_state linear_clamp {
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
};
struct Vertex {
    float4 pos : POSITION;
    float2 uv : TEXCOORD0;
};
Vertex vertex_shader(Vertex v)
{
    v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj);
    return v;
}
float4 capture_pixel(Vertex v) : TARGET
{
    // The SRGB-aware OBS filter supplies linear premultiplied pixels from its
    // floating-point intermediate. Store canonical sRGB-domain premultiplication.
    float4 p = image.Sample(linear_clamp, v.uv);
    p = float4(p.r >= 0.0 && p.r <= 65504.0 ? p.r : 0.0,
               p.g >= 0.0 && p.g <= 65504.0 ? p.g : 0.0,
               p.b >= 0.0 && p.b <= 65504.0 ? p.b : 0.0,
               p.a >= 0.0 && p.a <= 1.0 ? p.a : 0.0);
    float3 rgb = p.a > 0.000001 ? saturate(p.rgb / p.a) : float3(0.0, 0.0, 0.0);
    float3 low = rgb * 12.92;
    float3 high = 1.055 * pow(rgb, float3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) - 0.055;
    rgb = float3(rgb.r <= 0.0031308 ? low.r : high.r, rgb.g <= 0.0031308 ? low.g : high.g, rgb.b <= 0.0031308 ? low.b : high.b);
    return float4(rgb * p.a, p.a);
}
float4 downscale_pixel(Vertex v) : TARGET
{
    float2 uv = lerp(crop_bounds.xy, crop_bounds.zw, v.uv);
    float4 pixel = image.Sample(linear_clamp, uv);
    // OBS's intermediate contains premultiplied source alpha; the model uses straight RGB.
    return float4(pixel.a > 0.00001 ? saturate(pixel.rgb / pixel.a) : float3(0.0, 0.0, 0.0), 1.0);
}
float4 composite_pixel(Vertex v) : TARGET
{
    float2 uv = (v.uv - crop_bounds.xy) / (crop_bounds.zw - crop_bounds.xy);
    float inside = step(0.0, uv.x) * step(0.0, uv.y) * step(uv.x, 1.0) * step(uv.y, 1.0);
    float4 keyed = result_image.Sample(linear_clamp, uv);
    float source_alpha = original_image.Sample(linear_clamp, v.uv).a;
    float alpha = saturate(keyed.a * source_alpha) * inside;
    return float4(keyed.rgb * alpha, alpha);
}
technique Capture {
    pass { vertex_shader = vertex_shader(v); pixel_shader = capture_pixel(v); }
}
technique Downscale {
    pass { vertex_shader = vertex_shader(v); pixel_shader = downscale_pixel(v); }
}
technique Composite {
    pass { vertex_shader = vertex_shader(v); pixel_shader = composite_pixel(v); }
}
