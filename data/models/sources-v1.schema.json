{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later. Source metadata only; not an installable catalogue.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,128}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "format": {
            "enum": [
              "safetensors",
              "npz"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1099511627776
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "licenses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]{1,128}$"
            },
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true
          },
          "origin": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "repo": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  },
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "repo",
                  "revision",
                  "file"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "md5_base64": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9+/]{22}==$"
                  }
                },
                "required": [
                  "url",
                  "revision"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "path",
          "format",
          "bytes",
          "sha256",
          "licenses",
          "origin"
        ]
      },
      "minItems": 0,
      "maxItems": 2048,
      "uniqueItems": true
    },
    "$comment": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "schema_version",
    "sources"
  ]
}
