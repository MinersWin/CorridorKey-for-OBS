{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: GPL-3.0-or-later. Semantic checks also apply; see docs/dev/models-catalogue.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]{1,128}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 262144
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "text",
          "text_sha256",
          "source_url",
          "attribution",
          "scope"
        ]
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "$comment": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "schema_version",
    "licenses"
  ]
}
