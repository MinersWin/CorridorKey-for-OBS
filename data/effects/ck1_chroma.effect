// SPDX-License-Identifier: GPL-3.0-or-later
uniform float4x4 ViewProj;
uniform texture2d image;
uniform float similarity;
uniform float smoothness;
uniform int blue_screen;
sampler_state point_sampler { Filter = Point; AddressU = Clamp; AddressV = Clamp; };
struct Vertex { float4 pos : POSITION; float2 uv : TEXCOORD0; };
Vertex VS(Vertex v) { v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); return v; }
float4 PS(Vertex v) : TARGET
{
    float3 rgb = image.Sample(point_sampler, v.uv).rgb;
    float screen = blue_screen != 0 ? rgb.b : rgb.g;
    float other = blue_screen != 0 ? max(rgb.r, rgb.g) : max(rgb.r, rgb.b);
    float excess = max(0.0, screen - other);
    float alpha = 1.0 - smoothstep(similarity, similarity + smoothness, excess);
    return float4(alpha, alpha, alpha, 1.0);
}
technique Draw { pass { vertex_shader = VS(v); pixel_shader = PS(v); } }
